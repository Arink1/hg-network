# Which site this deployment serves: crafting | darkrp | rusty
NEXT_PUBLIC_SITE=crafting

# Optional. Overrides the public URL used for metadata and Stripe redirects.
# Production on Vercel falls back to the domain in the site config.
# NEXT_PUBLIC_SITE_URL=https://hgcrafting.com

# Stripe (Developers > API keys). Use one Stripe account for the whole network.
STRIPE_SECRET_KEY=
# Stripe (Developers > Webhooks). One endpoint per site: https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Supabase (Project settings > API). Shared by all three sites.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret your game servers send as "Authorization: Bearer <key>" to /api/deliveries
DELIVERY_API_KEY=

# Optional. Lets the store show Steam display names for GMod and Rust buyers.
STEAM_API_KEY=
